# ---------------------------------------------------------------------------
# AI providers. Add a key for any provider you want to offer. Users can also
# bring their own key in the app's "AI model" settings (stored in their
# browser only). With no keys at all, Appmaker runs in demo mode.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# PERPLEXITY_API_KEY=
# CEREBRAS_API_KEY=

# Default provider and model for users who haven't picked one.
# (Default: Anthropic / claude-opus-5, or the first provider with a key.)
# APPMAKER_PROVIDER=anthropic
# APPMAKER_MODEL=claude-opus-5

# "Any other AI": users can connect any public https AI endpoint that speaks
# the OpenAI or Anthropic API format (private/local addresses are refused).
# APPMAKER_DISABLE_CUSTOM_ENDPOINTS=1   # turn the custom option off
#
# Your own custom endpoint as a site-wide default (its key is only ever sent
# to this exact URL, never to addresses users type in):
# CUSTOM_AI_BASE_URL=https://my-gateway.example.com/v1
# CUSTOM_AI_API_KEY=
#
# Self-hosted installs only: allow local endpoints like Ollama/LM Studio.
# Never enable on a public server.
# APPMAKER_ALLOW_PRIVATE_ENDPOINTS=1

# Limits per client IP per hour.
# APPMAKER_RATE_LIMIT=30          # generations on the site's keys
# APPMAKER_BYOK_RATE_LIMIT=300    # generations with the user's own key
# APPMAKER_IMPORT_RATE_LIMIT=30   # website imports

# Force demo mode even when keys are set.
# APPMAKER_DEMO=1
